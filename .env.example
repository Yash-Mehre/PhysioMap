# Supabase pooled connection string for application queries.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"

# Supabase direct connection string for Prisma migrations.
DIRECT_URL="postgresql://postgres:[password]@[db-host]:5432/postgres"

# Optional bundled anatomy model. Override with a remote GLB/GLTF URL when needed.
NEXT_PUBLIC_AVATAR_MODEL_URL="/model/anatomy.glb"
