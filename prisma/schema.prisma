generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppLog {
  id        String   @id @default(cuid())
  level     LogLevel @default(info)
  source    String
  event     String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, event])
}

enum LogLevel {
  debug
  info
  warn
  error
}
